# Synthetic env cho integration-worker (CORE/1.0).
# Copy to .env (KHÔNG commit .env).

NODE_ENV=development
HRP_MOCK_MODE=deterministic
HRP_ORGANIZATION_ID=org-synthetic-001

HRP_POLL_INTERVAL_MS=5000
HRP_LEASE_DURATION_MS=60000
HRP_MAX_CONCURRENT_JOBS=4

HRP_NOW_EPOCH_MS=1700000000000

# CẤM (HRP core markers):
# HRP_DATABASE_URL — KHÔNG đặt (HRP core DSN).
# HRP_PRISMA_CLIENT_PATH — KHÔNG đặt (trỏ tới HRP runtime).
# HRP_PROVIDER_API_KEY — KHÔNG đặt (provider thật).
