{
  "name": "@hrp-engagement/context-panel",
  "version": "1.0.0-core1.9",
  "private": true,
  "description": "CORE/1.9 — Context Panel + Intake review mock UI. Pin contracts 0.0.8-g0.8-fixes.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run build:embed-ui && npm run build:ui",
    "build:emit": "tsc",
    "build:ui": "node scripts/build-ui.mjs",
    "build:embed-ui": "node scripts/build-embed-ui.mjs",
    "clean:embed-ui": "node scripts/clean-embed-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development HRP_MOCK_MODE=deterministic node --import tsx/esm src/server.ts"
  },
  "dependencies": {
    "@hrp-engagement/config": "file:../../packages/config",
    "@hrp-engagement/contracts": "file:../../packages/contracts",
    "@hrp-engagement/integration-api": "file:../integration-api",
    "@hrp-engagement/integration-store": "file:../../packages/integration-store",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
