{
  "name": "@hrp-engagement/integration-api",
  "version": "1.4.0-core1.7",
  "private": true,
  "description": "CORE/1.2 — Webhook Receiver & Idempotency (gateway mock CORE/1.1 + receiver). Pin contracts 0.0.8-g0.8-fixes.",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./orchestrator": "./dist/orchestrator/index.js",
