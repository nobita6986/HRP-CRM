    "typescript": "5.7.3",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "embedded-postgres": "17.6.0-beta.15",
    "pg": "8.13.1",
    "tsx": "4.19.2"
  },
  "engines": {
    "node": ">=20.0.0"
