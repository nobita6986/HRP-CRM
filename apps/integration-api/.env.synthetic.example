# Synthetic env cho integration-api (CORE/1.2).
# Copy to .env (KHÔNG commit .env).

NODE_ENV=development
HRP_MOCK_MODE=deterministic
HRP_ORGANIZATION_ID=org-synthetic-001

HRP_LISTEN_HOST=127.0.0.1
HRP_LISTEN_PORT=4001
HRP_MOCK_ROUTES=/health,/mock/integration,/mock/gateway
HRP_REQUEST_TIMEOUT_MS=15000

HRP_NOW_EPOCH_MS=1700000000000

# CORE/1.2 — Webhook Receiver (synthetic)
HRP_RECEIVER_ENABLED=true
HRP_RECEIVER_MAX_BODY_BYTES=262144
HRP_RECEIVER_RATE_LIMIT_PER_MIN=600
HRP_RECEIVER_RATE_MAP_IDLE_MS=300000
HRP_RECEIVER_RATE_MAP_MAX_ENTRIES=10000

# CORE/1.2 — DATABASE for durable ACK (synthetic, embedded-postgres in tests).
# Receiver 202 chỉ sau durable receipt + intent commit ở Integration Store.
# NOTE: env name is `DATABASE_URL` (plain), NOT `HRP_DATABASE_URL` (which
# config loader rejects as HRP core DSN marker).
DATABASE_URL=postgres://integration:synthetic@127.0.0.1:5432/integration_store

# CORE/1.2 — Connection Registry (rev 2 — Auditor F1 fix).
# Server-trusted map: (organizationId, provider, connectionId) → {secret, algorithm}.
# URL path KHÔNG đáng tin; registry PHẢI confirm trước verify.
# Format 1: JSON array (recommended).
HRP_WEBHOOK_CONNECTIONS=[{"organizationId":"org-synthetic-001","provider":"CHATWOOT","connectionId":"conn-synth-001","secret":"synthetic-hmac-secret-chatwoot-do-not-use","algorithm":"HMAC_SHA256"},{"organizationId":"org-synthetic-001","provider":"ZALO_OA","connectionId":"conn-synth-001","secret":"synthetic-hmac-secret-zalo-oa-do-not-use","algorithm":"HMAC_SHA256"},{"organizationId":"org-synthetic-001","provider":"GENERIC","connectionId":"conn-synth-001","secret":"synthetic-hmac-secret-generic-do-not-use","algorithm":"HMAC_SHA256"}]

# Format 2: pipe-delimited numbered (alternative).
# HRP_WEBHOOK_CONNECTION_0=org-synthetic-001|CHATWOOT|conn-synth-001|HMAC_SHA256|synthetic-hmac-secret-chatwoot-do-not-use

# CẤM (HRP core markers):
# HRP_DATABASE_URL — KHÔNG đặt (HRP core DSN).
# HRP_PRISMA_CLIENT_PATH — KHÔNG đặt (trỏ tới HRP runtime).
# HRP_PROVIDER_API_KEY — KHÔNG đặt (provider thật).
