# Synthetic env cho integration-store (CORE/1.3).
# Copy to .env (KHÔNG commit .env).
# Chỉ dùng cho DEV/TEST. KHÔNG dùng HRP DB.

# ─── Prisma datasource riêng của Integration store ──────────────
DATABASE_URL=postgresql://integration:synthetic@127.0.0.1:55432/integration_store?schema=integration

# ─── PRISMA schemaGeneration mode ───────────────────────────────
PRISMA_GENERATE_DATAPROXY=false

# ─── Test fixtures (CORE/1.3 synthetic) ─────────────────────────
HRP_INTEGRATION_FIXTURE_ORG_ID=org-synthetic-store-001

# CẤM:
# HRP_DATABASE_URL — KHÔNG đặt (HRP core DSN).
# HRP_PRISMA_CLIENT_PATH — KHÔNG đặt (trỏ tới HRP runtime).
